#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Batched qwen4exp gated delta rule with the fused per-head RMS/sigmoid-gate
// epilogue of dn_step_gate.comp. One workgroup per v-head; each thread owns one
// state row in registers across all Tn tokens, so the per-token arithmetic
// (and therefore the result) matches the serial kernel exactly.

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer BufC  { float conv[]; };  // [Tn][(2hK+hV)*dS]
layout(std430, binding = 1) readonly  buffer BufGB { float gb[]; };    // [Tn][g[hV], beta[hV]]
layout(std430, binding = 2)           buffer BufS  { vec4 s4[]; };     // [hV][dS][dS/4]
layout(std430, binding = 3) readonly  buffer BufW  { float w[]; };     // [dS] shared gamma
layout(std430, binding = 4) readonly  buffer BufZ  { float z[]; };     // [Tn][hV*dS]
layout(std430, binding = 5) writeonly buffer BufA  { float att[]; };   // [Tn][hV*dS]

layout(push_constant) uniform PC { uint dState; uint hK; uint hV; uint Tn; float eps; } pc;

shared vec4 qs4[64];
shared vec4 ks4[64];
shared float red[128];
shared float gateScale;

void main() {
    uint h = gl_WorkGroupID.x;
    uint j = gl_LocalInvocationID.x;
    uint dS = pc.dState;
    uint nv = dS / 4u;
    uint kh = h % pc.hK;
    float qScale = inversesqrt(float(dS));
    uint row = (h * dS + j) * nv;

    vec4 state[32];
    for (uint i = 0u; i < nv; ++i) state[i] = s4[row + i];

    for (uint t = 0u; t < pc.Tn; ++t) {
        uint co = t * (2u * pc.hK + pc.hV) * dS;
        uint qBase = co + kh * dS;
        uint kBase = co + pc.hK * dS + kh * dS;
        uint vBase = co + 2u * pc.hK * dS + h * dS;
        if (j < nv) {
            qs4[j] = vec4(conv[qBase + 4u*j], conv[qBase + 4u*j + 1u],
                          conv[qBase + 4u*j + 2u], conv[qBase + 4u*j + 3u]) * qScale;
            ks4[j] = vec4(conv[kBase + 4u*j], conv[kBase + 4u*j + 1u],
                          conv[kBase + 4u*j + 2u], conv[kBase + 4u*j + 3u]);
        }
        barrier();

        float decay = exp(gb[t * 2u * pc.hV + h]);
        float beta = gb[t * 2u * pc.hV + pc.hV + h];
        float vj = conv[vBase + j];

        float sk = 0.0;
        for (uint i = 0u; i < nv; ++i) sk += dot(state[i], ks4[i]);
        sk *= decay;
        float dj = beta * (vj - sk);

        float oj = 0.0;
        for (uint i = 0u; i < nv; ++i) {
            vec4 sn = state[i] * decay + ks4[i] * dj;
            state[i] = sn;
            oj += dot(sn, qs4[i]);
        }

        float sg = subgroupAdd(oj * oj);
        if (gl_SubgroupInvocationID == 0u) red[gl_SubgroupID] = sg;
        barrier();
        if (j == 0u) {
            float total = 0.0;
            for (uint i = 0u; i < gl_NumSubgroups; ++i) total += red[i];
            gateScale = 1.0 / sqrt(total / float(dS) + pc.eps);
        }
        barrier();
        uint outIndex = t * pc.hV * dS + h * dS + j;
        float zv = z[outIndex];
        att[outIndex] = oj * gateScale * w[j] * (1.0 / (1.0 + exp(-zv)));
        barrier();
    }

    for (uint i = 0u; i < nv; ++i) s4[row + i] = state[i];
}
