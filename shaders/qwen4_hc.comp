#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require

// qwen4exp hyper-connection elementwise stages. Matrix projections are separate.
// Layout: X/Gate/Y wide tensors are [token][stream][embedding].
// mode 0: per-stream RMSNorm with already-folded gamma (not 1 + gamma).
// mode 1: mean(X * sigmoid(Gate)) over streams; X is normalized here.
// mode 2: residual X + Block * 2*sigmoid(Inject / H).
// mode 3: GDN per-head RMSNorm (shared gamma), multiplied by sigmoid(Gate).
// mode 4: PLE per-stream signed-sqrt dot gate, broadcast over Block's value.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer Gamma { float gamma[]; };
layout(std430, binding = 2) readonly buffer Gate { float gate[]; };
layout(std430, binding = 3) readonly buffer Block { float block_out[]; };
layout(std430, binding = 4) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint N; uint H; uint T; uint mode; float eps; } pc;
shared float sums[256];

float sigmoid(float v) { return 1.0 / (1.0 + exp(-v)); }

void main() {
    uint tid = gl_LocalInvocationID.x, token = gl_WorkGroupID.z;
    if (token >= pc.T) return;
    if (pc.mode == 0u || pc.mode == 3u || pc.mode == 4u) {
        uint stream = gl_WorkGroupID.x;
        if (stream >= pc.H) return;
        uint base = (token * pc.H + stream) * pc.N;
        float sq = 0.0;
        for (uint i = tid; i < pc.N; i += 256u)
            sq += x[base + i] * (pc.mode == 4u ? gate[base+i] : x[base+i]);
        float wave = subgroupAdd(sq);
        if (gl_SubgroupInvocationID == 0u) sums[gl_SubgroupID] = wave;
        barrier();
        float total = subgroupAdd(tid < gl_NumSubgroups ? sums[tid] : 0.0);
        if (tid == 0u) {
            if (pc.mode == 4u) {
                float score = total * inversesqrt(float(pc.N));
                sums[0] = sigmoid(sign(score) * sqrt(max(abs(score), 1e-6)));
            } else sums[0] = inversesqrt(total / float(pc.N) + pc.eps);
        }
        barrier();
        for (uint i = tid; i < pc.N; i += 256u) {
            if (pc.mode == 4u) y[base+i] = block_out[token*pc.N+i] * sums[0];
            else y[base + i] = x[base + i] * sums[0] * gamma[(pc.mode == 3u ? 0u : stream * pc.N) + i]
                * (pc.mode == 3u ? sigmoid(gate[base+i]) : 1.0);
        }
    } else if (pc.mode == 1u) {
        uint i = gl_GlobalInvocationID.x;
        if (i >= pc.N) return;
        float sum = 0.0;
        for (uint h = 0u; h < pc.H; ++h) {
            uint j = (token * pc.H + h) * pc.N + i;
            sum += x[j] * sigmoid(gate[j]);
        }
        y[token * pc.N + i] = sum / float(pc.H);
    } else if (pc.mode == 2u) {
        uint i = gl_GlobalInvocationID.x;
        if (i >= pc.N * pc.H) return;
        uint stream = i / pc.N, j = token * pc.H * pc.N + i;
        float inject = 2.0 * sigmoid(gate[token * pc.H + stream] / float(pc.H));
        y[j] = x[j] + block_out[token * pc.N + i % pc.N] * inject;
    }
}
