#version 450
// out[i] = silu(g[i]) * u[i], the expert activation of moe_q5k_impl.glsl.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer G { float g[]; };
layout(std430, binding = 1) readonly buffer U { float u[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float gv = g[i];
    o[i] = (gv / (1.0 + exp(-gv))) * u[i];
}
