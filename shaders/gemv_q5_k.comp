#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : enable

// y[M] = W[M,K] . x[K], W in raw ggml Q5_K super-blocks (176 B = 44 dwords).
// Each lane owns one 32-element sub-block and reads it as whole dwords: the
// scale/min words, eight qh words and eight qs words, plus eight vec4 x loads,
// instead of one byte load per nibble. Same bindings, push constants, TPR
// specialization, grid and batch (z) semantics as the byte-addressed original
// (kept as gemv_q5_k_v1.comp for A/B checks).

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TPR = 256u;
// Optional fused epilogue (HC low-rank path): y = silu(sum * SILU_SCALE).
layout(constant_id = 1) const uint SILU_EPILOGUE = 0u;
layout(constant_id = 2) const float SILU_SCALE = 1.0;
float epilogue(float v) { if (SILU_EPILOGUE != 0u) { v *= SILU_SCALE; return v / (1.0 + exp(-v)); } return v; }
layout(std430, binding = 0) readonly buffer W { uint w32[]; };
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint M; uint K; } pc;
shared float partial[256];

void main() {
    uint tid = gl_LocalInvocationID.x, lane = tid % TPR;
    uint wg = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint row = wg * (256u / TPR) + tid / TPR;
    uint batch = gl_WorkGroupID.z;
    float acc = 0.0;
    if (row < pc.M) {
        uint blocks = pc.K / 256u;
        for (uint sub = lane; sub < blocks * 8u; sub += TPR) {
            uint g = sub & 7u, base = (row * blocks + (sub >> 3u)) * 44u;
            vec2 dm = unpackHalf2x16(w32[base]);
            uint s0 = w32[base + 1u], s1 = w32[base + 2u], s2 = w32[base + 3u];
            uint sc, mn;
            if (g < 4u) {
                sc = (s0 >> (8u * g)) & 63u;
                mn = (s1 >> (8u * g)) & 63u;
            } else {
                uint j = 8u * (g - 4u);
                uint a = (s2 >> j) & 255u;
                sc = (a & 15u) | ((((s0 >> j) & 255u) >> 6u) << 4u);
                mn = (a >> 4u) | ((((s1 >> j) & 255u) >> 6u) << 4u);
            }
            float d = dm.x * float(sc), m = dm.y * float(mn);
            uint qsBase = base + 12u + (g >> 1u) * 8u, shift = (g & 1u) * 4u;
            uint xo = (batch * pc.K + sub * 32u) / 4u;
            float s = 0.0, xs = 0.0;
            [[unroll]] for (uint j = 0u; j < 8u; ++j) {
                uint qs = w32[qsBase + j] >> shift, qh = w32[base + 4u + j] >> g;
                vec4 xv = x4[xo + j];
                vec4 q = vec4(float((qs & 15u) | ((qh & 1u) << 4u)),
                              float(((qs >> 8u) & 15u) | (((qh >> 8u) & 1u) << 4u)),
                              float(((qs >> 16u) & 15u) | (((qh >> 16u) & 1u) << 4u)),
                              float(((qs >> 24u) & 15u) | (((qh >> 24u) & 1u) << 4u)));
                s += dot(q, xv);
                xs += xv.x + xv.y + xv.z + xv.w;
            }
            acc += d * s - m * xs;
        }
    }
    if (TPR >= gl_SubgroupSize) {
        float v = subgroupAdd(acc);
        if (gl_SubgroupInvocationID == 0u) partial[tid / gl_SubgroupSize] = v;
        barrier();
        if (lane == 0u && row < pc.M) {
            float sum = 0.0;
            uint waves = TPR / gl_SubgroupSize, base = (tid / TPR) * waves;
            for (uint i = 0u; i < waves; ++i) sum += partial[base + i];
            y[batch * pc.M + row] = epilogue(sum);
        }
    } else {
        for (uint s = TPR / 2u; s > 0u; s >>= 1u) acc += subgroupShuffleXor(acc, s);
        if (lane == 0u && row < pc.M) y[batch * pc.M + row] = epilogue(acc);
    }
}
