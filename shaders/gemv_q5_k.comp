#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

layout(local_size_x = 256) in;
layout(constant_id = 0) const uint TPR = 256u;
struct block_q5_K {
    float16_t d, dmin;
    uint8_t scales[12];
    uint8_t qh[32];
    uint8_t qs[128];
};
layout(std430, binding = 0) readonly buffer W { block_q5_K w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };
layout(push_constant) uniform PC { uint M; uint K; } pc;
shared float partial[256];

void main() {
    uint tid = gl_LocalInvocationID.x, lane = tid % TPR;
    uint wg = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint row = wg * (256u / TPR) + tid / TPR;
    uint batch = gl_WorkGroupID.z;
    float acc = 0.0;
    if (row < pc.M) {
        uint blocks = pc.K / 256u;
        for (uint sub = lane; sub < blocks * 8u; sub += TPR) {
            uint g = sub % 8u, b = row * blocks + sub / 8u;
            uint sc = g < 4u ? uint(w[b].scales[g]) & 63u
                : (uint(w[b].scales[g + 4u]) & 15u) | ((uint(w[b].scales[g - 4u]) >> 6u) << 4u);
            uint mn = g < 4u ? uint(w[b].scales[g + 4u]) & 63u
                : (uint(w[b].scales[g + 4u]) >> 4u) | ((uint(w[b].scales[g]) >> 6u) << 4u);
            float d = float(w[b].d) * float(sc), m = float(w[b].dmin) * float(mn);
            uint xo = batch * pc.K + sub * 32u;
            for (uint i = 0u; i < 32u; ++i) {
                uint lo = (uint(w[b].qs[(g / 2u) * 32u + i]) >> ((g % 2u) * 4u)) & 15u;
                uint hi = (uint(w[b].qh[i]) >> g) & 1u;
                acc += (d * float(lo + 16u * hi) - m) * x[xo + i];
            }
        }
    }
    if (TPR >= gl_SubgroupSize) {
        float v = subgroupAdd(acc);
        if (gl_SubgroupInvocationID == 0u) partial[tid / gl_SubgroupSize] = v;
        barrier();
        if (lane == 0u && row < pc.M) {
            float sum = 0.0;
            uint waves = TPR / gl_SubgroupSize, base = (tid / TPR) * waves;
            for (uint i = 0u; i < waves; ++i) sum += partial[base + i];
            y[batch * pc.M + row] = sum;
        }
    } else {
        // TPR is a power of two dividing the subgroup; XOR cannot cross rows.
        for (uint s = TPR / 2u; s > 0u; s >>= 1u) {
            acc += subgroupShuffleXor(acc, s);
        }
        if (lane == 0u && row < pc.M) y[batch * pc.M + row] = acc;
    }
}
